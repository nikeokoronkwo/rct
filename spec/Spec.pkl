/// The RFC Conformance Test Suite
module org.rct.Spec

import "pkl:semver"

import "Action.pkl"
import "Requirement.pkl"
import "RFC.pkl"
import "section.pkl"
import "Spec.pkl"
import "TestSuite.pkl"

/// The current version of this document
fixed specversion = "0.1.0"

/// The metadata information about the RFC being implemented
rfc: RFC

/// The action description to use for the supported actions by this RFC RCT
///
/// Contains a map of action calls to their action description
actions: Mapping<String, Action>?

/// A list of requirements that the RFC spec has that can be enforced in the spec definition
requirements: Listing<Requirement>?

/// The test description, mapping test suites to names
tests: Listing<TestSuite>(!this.isEmpty)
