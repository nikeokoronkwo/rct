// Generates the RCT spec as a JSON Schema
import "@openapi/SchemaGenerator.pkl"
import "@rct/Spec.pkl"

generated_spec = SchemaGenerator.generate(Spec)

output {
  files {
    ["rctspec.json"] {
      value = generated_spec
      renderer = new JsonRenderer {}
    }
    ["rctspec.yaml"] {
      value = generated_spec
      renderer = new YamlRenderer {}
    }
  }
}
